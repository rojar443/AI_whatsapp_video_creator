# Paste into Railway -> web service -> Variables -> Raw Editor.
# Service setup: same repo, branch `public`, Root Directory empty, and this variable selects the image:
RAILWAY_DOCKERFILE_PATH=Dockerfile.web
# Private address of the backend service + its PORT. Baked in at build time: redeploy web if you change it.
BACKEND_URL=http://backend.railway.internal:8080
PORT=3100
# Then: Settings -> Networking -> Generate Domain, target port 3100. That domain is <web-domain> above.
