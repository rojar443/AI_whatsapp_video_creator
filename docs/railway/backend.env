# Paste into Railway -> backend service -> Variables -> Raw Editor.
# Replace every <...>. No quotes. ${{Postgres.DATABASE_URL}} is a Railway reference: keep it as written
# (the part before the dot must be your Postgres service's exact name).
DATABASE_URL=${{Postgres.DATABASE_URL}}
APP_ENV=production
SECRET_KEY=<long random string, 32+ chars>
PORT=8080
RAILWAY_RUN_UID=0
TASK_BACKEND=celery
STORAGE_LOCAL_DIR=/app/var/storage
WORK_DIR=/app/var/work
PLAYBOOK_DIR=/app/playbooks
MUSIC_LIBRARY_DIR=/app/music

# Your website's public address (fill in after the web service has a domain, then redeploy backend)
WEB_BASE_URL=https://<web-domain>
PUBLIC_BASE_URL=https://<web-domain>
CORS_ORIGINS=https://<web-domain>
COOKIE_SECURE=true
REGISTRATION_ENABLED=false

# Telegram (use a production bot, not the one you test with locally)
TELEGRAM_BOT_TOKEN=<token from BotFather>
TELEGRAM_BOT_USERNAME=<bot username without @>
ADMIN_TELEGRAM_IDS=<your numeric Telegram id>

# Required in production even though WhatsApp is off
WHATSAPP_ENABLED=false
WHATSAPP_APP_SECRET=<any random string>
WHATSAPP_VERIFY_TOKEN=<any random string>

# Start with offline stand-ins; switch on real providers when you have keys
AI_PROVIDER=rules
TRANSCRIPTION_PROVIDER=mock
TTS_PROVIDER=mock
