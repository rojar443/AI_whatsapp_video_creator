# ONE-SERVICE setup (the website + API + worker + bot in a single Railway service). Easiest way to show the UI.
# Service: same repo (your fork), branch `public`, Root Directory EMPTY, no RAILWAY_DOCKERFILE_PATH needed
# (the repo-root Dockerfile is this image). Add a Postgres database and a volume mounted at /app/var.
# Then Settings -> Networking -> Generate Domain (Railway picks the port itself: do NOT set PORT).
# Paste into Variables -> Raw Editor. Replace every <...>. Keep ${{Postgres.DATABASE_URL}} as written.
DATABASE_URL=${{Postgres.DATABASE_URL}}
APP_ENV=production
SECRET_KEY=<long random string, 32+ chars>
RAILWAY_RUN_UID=0
TASK_BACKEND=celery
STORAGE_LOCAL_DIR=/app/var/storage
WORK_DIR=/app/var/work
PLAYBOOK_DIR=/app/playbooks
MUSIC_LIBRARY_DIR=/app/music

# The domain Railway gives this service (add after you generate it, then redeploy)
WEB_BASE_URL=https://<this-service-domain>
PUBLIC_BASE_URL=https://<this-service-domain>
CORS_ORIGINS=https://<this-service-domain>
COOKIE_SECURE=true
REGISTRATION_ENABLED=false

# Telegram (optional to SEE the UI; needed for the bot and for Log in with Telegram)
TELEGRAM_BOT_TOKEN=<token from BotFather>
TELEGRAM_BOT_USERNAME=<bot username without @>
ADMIN_TELEGRAM_IDS=<your numeric Telegram id>

WHATSAPP_ENABLED=false
WHATSAPP_APP_SECRET=<any random string>
WHATSAPP_VERIFY_TOKEN=<any random string>

AI_PROVIDER=rules
TRANSCRIPTION_PROVIDER=mock
TTS_PROVIDER=mock
