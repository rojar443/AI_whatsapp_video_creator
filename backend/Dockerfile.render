FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_HTTP_TIMEOUT=600
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core curl \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml ./
# Include the configured provider SDKs; tests are not installed in this image.
RUN uv pip install --system -r pyproject.toml --extra all
COPY . .
RUN useradd --create-home --uid 1000 reelchat
EXPOSE 10000
# Initializes the mounted disk, then drops privileges before starting any app process.
CMD ["python", "-m", "app.render_runtime"]
