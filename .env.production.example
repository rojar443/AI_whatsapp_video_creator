# Production settings. Copy to .env on the server and fill in. Never commit .env.

# --- Your address. HTTPS on port 443.
#     SITE_ADDRESS = a name that points at the server: trusted certificate. Server IP 44.251.135.237 → 44-251-135-237.sslip.io (free).
#     SITE_IP      = the raw IP, also served on 443 with a self-signed certificate (browser warning).
#     With your own domain later: SITE_ADDRESS=your.domain and point its DNS A record at the IP.
SITE_ADDRESS=44-251-135-237.sslip.io
SITE_IP=44.251.135.237
WEB_BASE_URL=https://44-251-135-237.sslip.io
PUBLIC_BASE_URL=https://44-251-135-237.sslip.io
CORS_ORIGINS=https://44-251-135-237.sslip.io,https://44.251.135.237
COOKIE_SECURE=true

# --- Secrets: generate with  openssl rand -hex 32  (letters and digits only for the database password)
SECRET_KEY=
POSTGRES_PASSWORD=

# --- Telegram (required): token from @BotFather, bot username without @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- AI: Google Gemini directly. Native IDs have no google/ prefix.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Optional per-task models; blank uses AI_MODEL.
AI_MODEL_VISION=
AI_MODEL_SCRIPT=
# Alternative gateway configuration (use these together instead of the above):
# AI_PROVIDER=openai_compatible
# AI_MODEL=google/gemini-3.8-flash
# OPENAI_BASE_URL=https://gen.pollinations.ai/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

TTS_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock

# --- Product settings
MESSAGING_PROVIDER=dev
WHATSAPP_ENABLED=false
REGISTRATION_ENABLED=false
ANON_CREDITS=100000
ANON_MAX_PROJECTS=100000
MAX_JOBS_PER_DAY=100000
ASSET_RETENTION_DAYS=30
SOURCE_MEDIA_RETENTION_DAYS=7
