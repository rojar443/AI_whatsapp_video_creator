# Production settings. Copy to .env on the server and fill in. Never commit .env.

# --- Your address. No domain? Use  <server-ip>.sslip.io  (free, gets a real HTTPS certificate).
SITE_ADDRESS=reels.example.com
WEB_BASE_URL=https://reels.example.com
PUBLIC_BASE_URL=https://reels.example.com
CORS_ORIGINS=https://reels.example.com

# --- Secrets: generate with  openssl rand -hex 32  (letters and digits only for the database password)
SECRET_KEY=
POSTGRES_PASSWORD=

# --- Telegram (required): token from @BotFather, bot username without @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- AI (OpenAI-compatible gateway such as Pollinations, or set AI_PROVIDER=gemini + GEMINI_API_KEY)
AI_PROVIDER=openai_compatible
AI_MODEL=google/gemini-3.8-flash
OPENAI_BASE_URL=https://gen.pollinations.ai/v1
OPENAI_API_KEY=

TTS_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock

# --- Product settings
MESSAGING_PROVIDER=dev
WHATSAPP_ENABLED=false
REGISTRATION_ENABLED=false
ANON_CREDITS=100000
ANON_MAX_PROJECTS=100000
MAX_JOBS_PER_DAY=100000
ASSET_RETENTION_DAYS=30
SOURCE_MEDIA_RETENTION_DAYS=7
