# Copy to .env and fill in. Placeholders only — never commit real secrets.

APP_ENV=development                  # development | production
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
PUBLIC_BASE_URL=http://localhost:8100   # public URL of the API (signed download links)
WEB_BASE_URL=http://localhost:3100      # public URL of the website
CORS_ORIGINS=http://localhost:3100
COOKIE_SECURE=false                  # true behind HTTPS
# DATABASE_URL is set by docker-compose; for a local run without Docker:
# DATABASE_URL=postgresql+psycopg://reelchat:reelchat@localhost:55433/reelchat

# Bootstrap admin (created on API start if both are set)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---- AI agent: rules | anthropic | openai | openai_compatible | gemini
AGENT_PROVIDER=rules
AGENT_MODEL=                         # default model for all tasks (e.g. claude-opus-5-5)
AGENT_MODEL_ANALYSIS=                # optional per-task overrides
AGENT_MODEL_RESPONSE=
AGENT_MODEL_SCRIPT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                     # openai_compatible only, e.g. http://host.docker.internal:11434/v1 (Ollama)
GEMINI_API_KEY=

# ---- Speech
TRANSCRIPTION_PROVIDER=mock          # mock | openai
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=espeak                  # mock | espeak | openai
TTS_MODEL=gpt-4o-mini-tts

# ---- Video: mock (local FFmpeg text cards, watermarked) | stock (Pexels footage)
VIDEO_PROVIDER=mock
PEXELS_API_KEY=

# ---- WhatsApp: dev (built-in simulator) | meta (WhatsApp Cloud API)
MESSAGING_PROVIDER=dev
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=change-me-app-secret
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_NUMBER=15550000000
WHATSAPP_NOTIFY_TEMPLATE=reelchat_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Storage: local | s3 (any S3-compatible service)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Email: console (dev) | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ReelChat <no-reply@example.com>

# ---- Limits & retention
DEFAULT_CREDITS=10
MAX_JOBS_PER_DAY=10
DOWNLOAD_URL_TTL_SECONDS=86400
MESSAGE_RETENTION_DAYS=90
ASSET_RETENTION_DAYS=30
JOB_MAX_ATTEMPTS=3
