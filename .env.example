# Copy to .env and fill in. Placeholders only — never commit real secrets.
# Real WhatsApp setup walkthrough: docs/WHATSAPP_SETUP.md

APP_ENV=development                     # development | production
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
PUBLIC_BASE_URL=http://localhost:8100   # public URL of the API → your tunnel URL for real WhatsApp
WEB_BASE_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100
COOKIE_SECURE=false                     # true behind HTTPS
# DATABASE_URL / REDIS_URL / TASK_BACKEND are set by docker-compose.

# Bootstrap admin (created on API start if both are set)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---- AI provider: gemini | rules (offline) | openai | openai_compatible | anthropic | agenticorg
AI_PROVIDER=rules
AI_MODEL=gemini-flash-latest            # chat analysis; check https://ai.google.dev/gemini-api/docs/models
# optional: model for moment scoring (defaults to AI_MODEL)
AI_MODEL_VISION=
# optional: model for narration scripts
AI_MODEL_SCRIPT=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                     # openai_compatible only, e.g. http://host.docker.internal:11434/v1 (Ollama)

# Optional AgenticOrg message interpretation provider
AGENT_PROVIDER=rules
AGENTICORG_API_KEY=
AGENTICORG_AGENT_NAME=               # existing video interpretation agent UUID
AGENTICORG_COMPANY_ID=               # required when AGENTICORG_AGENT_NAME is an agent type
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_ACTION=process

# ---- Speech
TRANSCRIPTION_PROVIDER=mock             # gemini | mock
TTS_PROVIDER=mock                       # elevenlabs | mock (silent, offline) | espeak (build with APT_EXTRA=espeak-ng)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Processing pipeline: each step = builtin | python:package.module:Class | https://your-agent/endpoint
# Steps: quality_filter scene_split moment_scoring sequencing script narration captions music render
# optional YAML (see backend/pipeline.example.yaml)
PIPELINE_CONFIG_FILE=
PIPELINE_MOMENT_SCORING=builtin
PIPELINE_SCRIPT=builtin
PIPELINE_RENDER=builtin
# Bearer token sent to your HTTP agents
PIPELINE_HTTP_TOKEN=
PIPELINE_FALLBACK_TO_BUILTIN=true

# ---- WhatsApp: dev (built-in simulator) | meta (WhatsApp Cloud API)
MESSAGING_PROVIDER=dev
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=change-me-app-secret
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_NUMBER=15550000000
WHATSAPP_NOTIFY_TEMPLATE=hello_world    # approved template used outside the 24 h window
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_PARAMS=0              # number of {{n}} variables in that template
# only for the named tunnel profile
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Telegram (optional input channel). Create a bot with @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=
# e.g. Chat2ReelBot (public; used for website links)
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram user ids that become admins (find yours with @userinfobot)
ADMIN_TELEGRAM_IDS=
REGISTRATION_ENABLED=false             # website signup off (Telegram needs no account)
WHATSAPP_ENABLED=false                  # Telegram-first; set true to show WhatsApp linking

# ---- Storage: local | s3 (private bucket; build the image with EXTRAS=dev,s3)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Email: console (dev) | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ReelChat <no-reply@example.com>

# ---- Limits, quotas, retention
MAX_FILES_PER_PROJECT=20
MAX_VIDEO_BYTES=104857600
MAX_CLIP_SECONDS=180
BATCH_TIMEOUT_SECONDS=90
DEFAULT_CREDITS=10
ANON_CREDITS=2
ANON_MAX_PROJECTS=2
MAX_JOBS_PER_DAY=10
ASSET_RETENTION_DAYS=30
ANON_RETENTION_DAYS=3
SOURCE_MEDIA_RETENTION_DAYS=7
MESSAGE_RETENTION_DAYS=90
